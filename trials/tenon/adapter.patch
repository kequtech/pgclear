new file mode 100644
--- /dev/null
+++ b/src/driver/session.ts
@@ -0,0 +1,16 @@
+import type { Session, InputValue } from '@kequtech/pgclear';
+import type { UnknownRow } from '../query.js';
+
+/** Keep the catalog/tool SQL calling convention at Tenon's boundary. */
+export class SessionClient {
+  constructor(readonly session: Session) {}
+  query<Row extends object = UnknownRow>(text: string, values: readonly unknown[] = []) {
+    return this.session.queryClassic<Row>(text, values as readonly InputValue[]);
+  }
+  script(text: string) {
+    return this.session.script(text);
+  }
+  describe(text: string) {
+    return this.session.describe(text);
+  }
+}
