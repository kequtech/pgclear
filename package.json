{
  "name": "@kequtech/pgclear",
  "version": "0.0.0",
  "private": true,
  "description": "A standalone TypeScript PostgreSQL driver with explicit session ownership",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kequtech/pgclear.git"
  },
  "homepage": "https://github.com/kequtech/pgclear#readme",
  "bugs": {
    "url": "https://github.com/kequtech/pgclear/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "kequtech": {
    "source": "pgclear"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  }
}
