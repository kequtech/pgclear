{
  "name": "@kequtech/pgclear",
  "version": "0.0.0",
  "private": true,
  "description": "A standalone TypeScript PostgreSQL driver with explicit session ownership",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kequtech/pgclear.git"
  },
  "homepage": "https://github.com/kequtech/pgclear#readme",
  "bugs": {
    "url": "https://github.com/kequtech/pgclear/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "test:compile": "node scripts/build.mjs --test",
    "test:unit": "npm run build && npm run test:compile && node --test .test-dist/test/*.test.js benchmarks/*.test.mjs",
    "test:integration": "npm run test:compile && node --env-file-if-exists=.env --test .test-dist/test/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "prepack": "npm run build",
    "trial:tenon": "node --env-file-if-exists=.env trials/tenon/run.mjs",
    "test:compat": "npm run test:compile && node --test --test-timeout=45000 .test-dist/test/compatibility/*.test.js",
    "benchmark": "node --env-file-if-exists=.env benchmarks/run.mjs"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "kequtech": {
    "source": "pgclear"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "docs/",
    "LICENSE",
    "README.md"
  ]
}
